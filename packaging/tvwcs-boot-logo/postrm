#!/bin/sh
# Back to the start-up text: the GRUB drop-in is gone with the package, and Plymouth goes back to its default theme.
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ "$(plymouth-set-default-theme 2>/dev/null)" = tvwcs ]; then
        plymouth-set-default-theme --reset || true
    fi
    if command -v update-initramfs >/dev/null 2>&1; then update-initramfs -u || true; fi
    if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then update-grub || true; fi
fi
exit 0
