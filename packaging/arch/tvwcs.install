# pacman runs these. What TVWCS's Settings set up outside its own files goes when the package is removed (as the .deb's
# prerm does): without TVWCS's session, an automatic login into it would fail.

post_install() {
  echo "TVWCS is installed. Choose the TVWCS session at your login screen, or type tvwcs at a text console."
  echo "Settings > User sets up the automatic login. See /usr/share/doc/tvwcs/INSTALL-ARCH.md."
}

pre_remove() {
  # the first text console's automatic login (Settings > User, without a login screen)
  if [ -f /etc/systemd/system/getty@tty1.service.d/tvwcs-autologin.conf ]; then
    rm -f /etc/systemd/system/getty@tty1.service.d/tvwcs-autologin.conf
    rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
  fi
  # greetd back to its own text login (the old config is kept as config.toml.tvwcs-backup)
  if grep -q tvwcs-session /etc/greetd/config.toml 2>/dev/null; then
    cp /etc/greetd/config.toml /etc/greetd/config.toml.tvwcs-backup
    printf '%s\n' "[terminal]" "vt = 1" "" "[default_session]" 'command = "agreety --cmd /bin/sh"' 'user = "greeter"' > /etc/greetd/config.toml
  fi
  rm -f /etc/lightdm/lightdm.conf.d/50-tvwcs-autologin.conf /etc/sddm.conf.d/50-tvwcs-autologin.conf
  # server mode's switch and polkit rule
  rm -f /etc/tvwcs/server-mode /etc/polkit-1/rules.d/50-tvwcs-server-mode.rules
  rmdir /etc/tvwcs 2>/dev/null || true
}
