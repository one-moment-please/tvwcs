#!/bin/sh
# The bytecode postinst compiled is not in the package's file list: remove it with the package.
# Settings > User's automatic login on the first text console (without a login screen) goes too: without TVWCS's
# session to start, it would leave that console logged in at a shell.
set -e
rm -rf /usr/lib/tvwcs/tvwcs/__pycache__
if [ "$1" = remove ] && [ -f /etc/systemd/system/getty@tty1.service.d/tvwcs-autologin.conf ]; then
    rm -f /etc/systemd/system/getty@tty1.service.d/tvwcs-autologin.conf
    rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
    if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
fi
# A login screen's automatic login into TVWCS's session would fail without it: LightDM and SDDM lose TVWCS's
# automatic-login file, and greetd what TVWCS added to its config.
if [ "$1" = remove ]; then
    # greetd: only what TVWCS added goes (the automatic login into its session, and agreety starting it after the
    # password, which then starts a shell); the greeter, console and anything else in the file stay as they are.
    if grep -q tvwcs-session /etc/greetd/config.toml 2>/dev/null; then
      awk -v greeter="/usr/sbin/agreety --cmd /bin/sh" '
        function flush() { if (held != "" && held !~ /tvwcs-session/) printf "%s", held; held = "" }
        /^[ \t]*\[/ { flush(); s = $0; gsub(/[ \t]/, "", s); sub(/^\[/, "", s); sub(/\].*/, "", s) }
        s == "initial_session" { held = held $0 "\n"; next }
        s == "default_session" && /^[ \t]*command[ \t]*=/ && /tvwcs-session/ { print "command = \"" greeter "\""; next }
        { print }
        END { flush() }' /etc/greetd/config.toml > /etc/greetd/config.toml.tvwcs-new
      cat /etc/greetd/config.toml.tvwcs-new > /etc/greetd/config.toml; rm -f /etc/greetd/config.toml.tvwcs-new
      echo "greetd no longer starts TVWCS (/etc/greetd/config.toml)."
    fi
    rm -f /etc/lightdm/lightdm.conf.d/50-tvwcs-autologin.conf /etc/sddm.conf.d/50-tvwcs-autologin.conf
fi
# Server mode's switch and polkit rule: without TVWCS there is no TV to keep away from the server's settings.
if [ "$1" = remove ]; then
    rm -f /etc/tvwcs/server-mode /etc/polkit-1/rules.d/50-tvwcs-server-mode.rules
    rmdir /etc/tvwcs 2>/dev/null || true
fi
exit 0
