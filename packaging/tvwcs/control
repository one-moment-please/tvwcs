Depends: python3, python3-gi, gir1.2-gtk-4.0, sway, swayidle, swaylock, pulseaudio-utils, network-manager, udisks2, libglib2.0-bin, xdg-desktop-portal, xdg-desktop-portal-gtk, adwaita-icon-theme, fonts-open-sans
