#!/bin/sh
# TVWCS's own session: sway with TVWCS's session config (~/.config/tvwcs/sway-session.conf), in which TVWCS runs in
# TV mode. Part of the tvwcs package. Started by the login screen's "TVWCS" entry or its automatic login, or from a
# text console. The first time, the session config is made from sway's standard config (/etc/sway/config); edit it
# as you like. The session has no sway bar: the Quick Menu shows the time and status.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/tvwcs
CFG=$CONF/sway-session.conf
HK=$CONF/hotkeys.conf
STD=${TVWCS_SWAY_STANDARD_CONFIG:-/etc/sway/config}
NO_BAR="# TVWCS: this session has no sway bar (the Quick Menu shows the time and status), so its bar blocks are commented out."
# Comment out a config's bar blocks, so sway never starts swaybar here (TV mode used to hide it a moment later, after
# it had flashed on screen). Only the session config: the usual sway session keeps its bar.
no_bar() {
    awk '!inbar && /^[[:space:]]*bar([[:space:]]+[^{[:space:]]+)?[[:space:]]*\{/ { inbar=1; depth=0 }
         inbar { line=$0; depth+=gsub(/\{/,"",line)-gsub(/\}/,"",line); print "#" $0; if (depth<=0) inbar=0; next }
         { print }' "$1"
}
mkdir -p "$CONF"
if [ ! -f "$CFG" ]; then
    { echo "# TVWCS's own sway session (\"TVWCS\" at the login screen): TVWCS runs here in TV mode. Made by tvwcs-session"
      echo "# from sway's standard config; edit it as you like. Your usual sway config is not used in this session."
      echo "$NO_BAR"; no_bar "$STD"; echo; echo "# TVWCS: its hotkeys, window rules and autostart."; echo "include /usr/share/tvwcs/tvwcs.conf"; } > "$CFG"
# A config made before 5.2.1 still has sway's standard bar: comment it out once (a bar added afterwards is kept, and
# TV mode hides it)
elif ! grep -qF "$NO_BAR" "$CFG" && { echo "$NO_BAR"; no_bar "$CFG"; } > "$CFG.tmp"; then
    mv -f "$CFG.tmp" "$CFG"
else
    rm -f "$CFG.tmp"
fi
# TVWCS 4.x lived in ~/.local/share/tvwcs: its include line and hotkeys point at the package now
if grep -q '\.local/share/tvwcs/' "$CFG" "$HK" 2>/dev/null; then
    sed -i -e 's#^\([[:space:]]*include[[:space:]]\).*\.local/share/tvwcs/tvwcs\.conf.*#\1/usr/share/tvwcs/tvwcs.conf#' "$CFG"
    [ ! -f "$HK" ] || sed -i -e "s#'[^']*/\.local/share/tvwcs/bin/tvwcs'#/usr/bin/tvwcs#g" "$HK"
fi
if [ ! -f "$HK" ]; then
    { echo "# Generated by TVWCS Settings. Change hotkeys there; edits made here are overwritten."
      echo "# Keyboard: Quick Menu (Super (tap))"; echo "bindcode --release 133 exec /usr/bin/tvwcs toggle"
      echo "# Remote: Quick Menu (F2)"; echo "bindsym F2 exec /usr/bin/tvwcs toggle"; } > "$HK"
fi
# Wait (up to 5 s) until logind says this login is the active one. LightDM switches from its login screen's console to
# the session's a moment after starting the session, and the libseat in Ubuntu 24.04 and Linux Mint 22 (0.8.0) checks
# only once, when sway starts: it misses the switch, waits 10 s and gives up ("Timeout waiting session to become
# active"), back at the login screen. Quick when the session is already active, or without logind.
if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
    i=0
    while [ "$i" -lt 50 ]; do
        ACTIVE=$(loginctl show-session "$XDG_SESSION_ID" -p Active --value 2>/dev/null) || break
        [ "$ACTIVE" != yes ] || break
        sleep 0.1; i=$((i+1))
    done
fi
XDG_SESSION_TYPE=wayland; XDG_CURRENT_DESKTOP=sway; XDG_SESSION_DESKTOP=sway
TVWCS_SESSION=sway; TVWCS_SESSION_CONFIG=$CFG
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP TVWCS_SESSION TVWCS_SESSION_CONFIG
exec sway -c "$CFG"
