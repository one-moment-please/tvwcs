#!/bin/sh
# TVWCS's own session: sway with TVWCS's session config (~/.config/tvwcs/sway-session.conf), in which TVWCS runs in
# TV mode. Part of the tvwcs package. Started by the login screen's "TVWCS" entry or its automatic login, or from a
# text console. The first time, the session config is made from sway's standard config (/etc/sway/config); edit it
# as you like.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/tvwcs
CFG=$CONF/sway-session.conf
HK=$CONF/hotkeys.conf
mkdir -p "$CONF"
if [ ! -f "$CFG" ]; then
    { echo "# TVWCS's own sway session (\"TVWCS\" at the login screen): TVWCS runs here in TV mode. Made by tvwcs-session"
      echo "# from sway's standard config; edit it as you like. Your usual sway config is not used in this session."
      cat /etc/sway/config; echo; echo "# TVWCS: its hotkeys, window rules and autostart."; echo "include /usr/share/tvwcs/tvwcs.conf"; } > "$CFG"
fi
# TVWCS 4.x lived in ~/.local/share/tvwcs: its include line and hotkeys point at the package now
if grep -q '\.local/share/tvwcs/' "$CFG" "$HK" 2>/dev/null; then
    sed -i -e 's#^\([[:space:]]*include[[:space:]]\).*\.local/share/tvwcs/tvwcs\.conf.*#\1/usr/share/tvwcs/tvwcs.conf#' "$CFG"
    [ ! -f "$HK" ] || sed -i -e "s#'[^']*/\.local/share/tvwcs/bin/tvwcs'#/usr/bin/tvwcs#g" "$HK"
fi
if [ ! -f "$HK" ]; then
    { echo "# Generated by TVWCS Settings. Change hotkeys there; edits made here are overwritten."
      echo "# Keyboard: Quick Menu (Super (tap))"; echo "bindcode --release 133 exec /usr/bin/tvwcs toggle"
      echo "# Remote: Quick Menu (F2)"; echo "bindsym F2 exec /usr/bin/tvwcs toggle"; } > "$HK"
fi
XDG_SESSION_TYPE=wayland; XDG_CURRENT_DESKTOP=sway; XDG_SESSION_DESKTOP=sway
TVWCS_SESSION=sway; TVWCS_SESSION_CONFIG=$CFG
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP TVWCS_SESSION TVWCS_SESSION_CONFIG
exec sway -c "$CFG"
