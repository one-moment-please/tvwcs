[Desktop Entry]
Type=Application
Name=Control Panel
GenericName=System settings
Comment=Sound, displays, Bluetooth, software updates, system information, a terminal and the network, made for a remote
Exec=tvwcs control
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=sound;volume;audio;display;monitor;resolution;refresh;bluetooth;updates;system;terminal;network;wifi;ethernet;
StartupWMClass=com.tvwcs.ControlPanel
Actions=sound;displays;bluetooth;updates;system;terminal;network;

[Desktop Action sound]
Name=Sound
Exec=tvwcs control sound

[Desktop Action displays]
Name=Displays
Exec=tvwcs control displays

[Desktop Action bluetooth]
Name=Bluetooth
Exec=tvwcs control bluetooth

[Desktop Action updates]
Name=Software updates
Exec=tvwcs control updates

[Desktop Action system]
Name=System information
Exec=tvwcs control system

[Desktop Action terminal]
Name=Terminal
Exec=tvwcs control terminal

[Desktop Action network]
Name=Network
Exec=tvwcs control network
