[Desktop Entry]
Type=Application
Name=TVWCS Settings
GenericName=System settings
Comment=TVWCS's look, user and login, remote and hotkeys, sound, displays, power, Bluetooth, software updates, system information, the network and storage, made for a remote
Exec=tvwcs settings
Icon=tvwcs-settings
Terminal=false
Categories=Settings;System;
NotShowIn=GNOME;KDE;
Keywords=options;appearance;user;login;remote;keyboard;gamepad;power;sleep;lock;settings;control panel;hotkeys;sound;volume;audio;display;monitor;resolution;refresh;bluetooth;time;updates;system;network;wifi;ethernet;storage;drives;
StartupWMClass=com.tvwcs.ControlPanel
Actions=appearance;user;hotkeys;sound;displays;power;bluetooth;datetime;updates;system;network;storage;

[Desktop Action appearance]
Name=Appearance
Exec=tvwcs settings appearance

[Desktop Action user]
Name=User
Exec=tvwcs settings user

