[Desktop Entry]
Type=Application
Name=Settings
GenericName=System settings
Comment=TVWCS's options, sound, displays, Bluetooth, software updates, system information, a terminal and the network, made for a remote
Exec=tvwcs settings
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=options;power;sleep;screensaver;lock;settings;control panel;hotkeys;sound;volume;audio;display;monitor;resolution;refresh;bluetooth;updates;system;terminal;network;wifi;ethernet;
StartupWMClass=com.tvwcs.ControlPanel
Actions=options;sound;displays;power;bluetooth;updates;system;terminal;network;

[Desktop Action options]
Name=Options
Exec=tvwcs settings options

[Desktop Action sound]
Name=Sound
Exec=tvwcs settings sound

[Desktop Action displays]
