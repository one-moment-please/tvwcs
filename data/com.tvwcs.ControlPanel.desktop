[Desktop Entry]
Type=Application
Name=TVWCS Settings
GenericName=System settings
Comment=TVWCS's options, remote and hotkeys, sound, displays, Bluetooth, apps from Flathub, software updates, system information, a terminal and the network, made for a remote
Exec=tvwcs settings
Icon=preferences-system
Terminal=false
Categories=Settings;System;
NotShowIn=GNOME;KDE;
Keywords=options;features;minimal;remote;keyboard;gamepad;power;sleep;screensaver;lock;settings;control panel;hotkeys;sound;volume;audio;display;monitor;resolution;refresh;bluetooth;apps;flatpak;flathub;store;install;updates;system;terminal;network;wifi;ethernet;
StartupWMClass=com.tvwcs.ControlPanel
Actions=options;features;hotkeys;sound;displays;power;bluetooth;apps;updates;system;terminal;network;

[Desktop Action options]
Name=Options
Exec=tvwcs settings options

[Desktop Action features]
Name=Features
Exec=tvwcs settings features

