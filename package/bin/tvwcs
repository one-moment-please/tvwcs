#!/bin/sh
# TVWCS launcher. Works from the tvwcs package (/usr/bin/tvwcs, with the Python package in /usr/lib/tvwcs) and from
# the repository (package/bin next to package/tvwcs).
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=/usr/lib/tvwcs
for CAND in "$DIR/.." "$DIR"; do
    if [ -f "$CAND/tvwcs/main.py" ]; then ROOT=$CAND; break; fi
done
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# Plain `tvwcs` at a text console (no graphical session): TVWCS's own sway session, in TV mode. Elsewhere tvwcs.main
# decides (sway_include.where).
if [ $# -eq 0 ] && [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    if [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then
        echo "tvwcs starts TVWCS's session on the computer's own screen: run it at its text console, not over SSH." >&2; exit 1
    fi
    if command -v pgrep >/dev/null 2>&1 && pgrep -u "$(id -u)" -x sway >/dev/null 2>&1; then
        echo "A sway session of yours is already running (on another console). TVWCS runs once per user: use that one." >&2; exit 1
    fi
    SESSION=/usr/bin/tvwcs-session
    [ "$ROOT" = /usr/lib/tvwcs ] || [ ! -x "$ROOT/../data/tvwcs-session" ] || SESSION=$ROOT/../data/tvwcs-session
    exec "$SESSION"
fi
# The lock screen without GTK, so a session that starts locked (lockscreen.py) locks as soon as it can
case "${1:-}" in lock|lock-at-start) exec python3 -m tvwcs.lockscreen "$@" ;; esac
exec python3 -m tvwcs.main "$@"
